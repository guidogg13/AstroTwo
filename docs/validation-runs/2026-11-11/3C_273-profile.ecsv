# %ECSV 1.0
# ---
# datatype:
# - {name: section, datatype: string}
# - {name: quantity, datatype: string}
# - {name: value, datatype: float64, description: 'numeric value as in the result (empty for texts, booleans and integers not exact in
#     float64)'}
# - {name: value_text, datatype: string, description: 'value exactly as in the result (shortest repr of the float64, integer digits, text)'}
# - {name: unit, datatype: string}
# - {name: error, datatype: float64}
# - {name: error_lower, datatype: float64}
# - {name: error_upper, datatype: float64}
# - {name: interval_lower, datatype: float64}
# - {name: interval_upper, datatype: float64}
# - {name: interval_kind, datatype: string}
# - {name: band, datatype: string}
# - {name: system, datatype: string}
# - {name: upper_limit, datatype: bool, description: 'SED point that is an upper limit: never a measurement'}
# - {name: method, datatype: string}
# - {name: formula, datatype: string}
# - {name: service, datatype: string}
# - {name: server, datatype: string, description: URL of the server that actually answered (also a mirror)}
# - {name: table, datatype: string}
# - {name: query, datatype: string}
# - {name: identifier, datatype: string}
# - {name: match, datatype: string}
# - {name: reference, datatype: string}
# - {name: note, datatype: string}
# - {name: retrieved_at, datatype: string}
# - {name: from_cache, datatype: string}
# - {name: command_id, datatype: int64, description: number of the object.profile command that produced the value}
# meta: !!omap
# - {A2VERS: AstroTwo 1.0.0}
# - {A2KIND: object_profile}
# - target: {name: 3C 273, origin: null, position: null, simbad_id: null}
# - {main_id: 3C 273}
# - position:
#     epoch: J2000.000
#     epoch_reason: null
#     equinox: null
#     frame: icrs
#     lat: {unit: deg, value: 2.05238823055}
#     lon: {unit: deg, value: 187.27791594049}
#     obstime: null
# - {position_source: 'SIMBAD (Harvard mirror), ICRS J2000 (coo_bibcode 2020yCat.1350....0G)'}
# - commands: [1]
# schema: astropy-2.0
section quantity value value_text unit error error_lower error_upper interval_lower interval_upper interval_kind band system upper_limit method formula service server table query identifier match reference note retrieved_at from_cache command_id
